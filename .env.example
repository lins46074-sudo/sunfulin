# 复制本文件为 .env 后按需修改。
# 注意：.env 不会覆盖「已存在的系统环境变量」(override=False)。
#       若某项在系统里已经设置，改这里是不生效的，请改系统环境变量。

# ---- 对话模型 ----
RAG_MODEL=deepseek-chat
RAG_MAX_TOKENS=2048

# 接口地址。换成官方 Claude 时改成：https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ---- 凭证 ----
# 留空即可。程序会自动读取系统环境变量 ANTHROPIC_API_KEY，
# 读不到时回退到 ANTHROPIC_AUTH_TOKEN。不要把真实 key 写进本文件。
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# ---- 向量模型与检索 ----
RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ---- HuggingFace 镜像（国内必需，否则模型下载超时）----
HF_ENDPOINT=https://hf-mirror.com
